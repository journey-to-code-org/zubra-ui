<!--
  The bottom of a site: the brand and a line about it, columns of links, and the small print
  (copyright, legal links). Columns wrap as space runs out. `columns` is
  `[{ heading, links: [{ label, href }] }]`.
  @slot brand - The logo or name (defaults to `brand`).
  @slot - The line under the brand.
  @slot legal - The small print at the bottom (defaults to `legal`).
-->
<style>
  :host { display: block; }
  footer { display: grid; gap: 2rem; padding: 2.5rem clamp(1rem, 4vw, 2.5rem) 1.5rem; border-top: 1px solid var(--border, #e4e4e7); background: color-mix(in oklab, var(--muted, #f4f4f5) 35%, var(--background, #fff)); }
  .footer-top { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); gap: 2rem; }
  .footer-brand { display: grid; align-content: start; gap: 0.5rem; grid-column: span 2; max-width: 22rem; }
  .footer-name { font-weight: 800; font-size: 1.1rem; }
  .footer-about { color: color-mix(in oklab, var(--muted-foreground, #71717a) 75%, var(--foreground, #18181b)); font-size: 0.9rem; }
  h2 { margin: 0 0 0.6rem; font-size: 0.85rem; font-weight: 700; }
  ul { display: grid; gap: 0.4rem; margin: 0; padding: 0; list-style: none; font-size: 0.9rem; }
  a { color: color-mix(in oklab, var(--muted-foreground, #71717a) 70%, var(--foreground, #18181b)); text-decoration: none; }
  a:hover { color: var(--foreground, #18181b); text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible { outline: 2px solid var(--ring, #a1a1aa); outline-offset: 2px; border-radius: 2px; }
  .footer-legal { padding-top: 1.25rem; border-top: 1px solid var(--border, #e4e4e7); font-size: 0.8rem; color: color-mix(in oklab, var(--muted-foreground, #71717a) 75%, var(--foreground, #18181b)); }
  @media (max-width: 30rem) { .footer-brand { grid-column: auto; } }
</style>
<site-footer brand="" columns={[]} legal="">
  <footer>
    <div class="footer-top">
      <div class="footer-brand"><span class="footer-name"><zb-slot name="brand">{brand}</zb-slot></span><div class="footer-about"><zb-slot></zb-slot></div></div>
      <zb-each items={columns} as="column" key={column.heading}>
        <nav aria-label={column.heading}>
          <h2>{column.heading}</h2>
          <ul>
            <zb-each items={column.links} as="link" key={link.href + link.label}>
              <li><a href={link.href}>{link.label}</a></li>
            </zb-each>
          </ul>
        </nav>
      </zb-each>
    </div>
    <div class="footer-legal"><zb-slot name="legal">{legal}</zb-slot></div>
  </footer>
</site-footer>
