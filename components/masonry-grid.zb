<!--
  A masonry layout for any items of different heights (cards, notes, photos): packed into columns
  as wide as `column` allows, while the order stays the reading order, so Tab, screen readers
  and search see the items left to right, top to bottom, as written.
  @slot - The items: any elements.
-->
<script>
  import { onMount } from '@zubra/runtime'

  let grid = null

  // Each item spans as many small rows as it is tall (re-measured as it resizes: images loading,
  // text wrapping), so CSS grid packs the columns without moving anything in the DOM.
  onMount(() => {
    const ROW = 4
    const fit = (item) => {
      const gap = parseFloat(getComputedStyle(grid).columnGap) || 0
      item.style.gridRowEnd = `span ${Math.max(1, Math.ceil((item.getBoundingClientRect().height + gap) / ROW))}`
    }
    const sizes = new ResizeObserver((entries) => entries.forEach((entry) => fit(entry.target)))
    // Slotted items are the page's, which this component's styles don't reach: each is set to its
    // own height here (stretched to its rows, it would measure taller each time).
    const watch = () => [...grid.children].forEach((item) => { item.style.alignSelf = 'start'; sizes.observe(item) })
    watch()
    const added = new MutationObserver(watch)
    added.observe(grid, { childList: true })
    return () => { sizes.disconnect(); added.disconnect() }
  })
</script>
<style>
  :host { display: block; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--column)), 1fr)); grid-auto-rows: 4px; column-gap: var(--gap); }
</style>
<masonry-grid column="16rem" gap="1rem">
  <div class="grid" ref={grid} style:--column={column} style:--gap={gap}><zb-slot></zb-slot></div>
</masonry-grid>
