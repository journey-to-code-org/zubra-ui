<!--
  Frequently asked questions, each opening to its answer, on native <details>: the browser does the
  keyboard, find-in-page opens the right answer, and with `single` only one is open at a time.
  `items` is `[{ question, answer }]`.
  @slot heading - A heading above the list (defaults to `heading`, shown only when set).
-->
<script>
  import { id } from '@zubra/runtime'

  const group = id()
</script>
<style>
  :host { display: block; }
  h2 { margin: 0 0 1rem; font-size: 1.5rem; letter-spacing: -0.02em; }
  .faq { border-top: 1px solid var(--border, #e4e4e7); }
  details { border-bottom: 1px solid var(--border, #e4e4e7); }
  summary { display: flex; align-items: center; gap: 1rem; padding: 1rem 0.25rem; font-weight: 600; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; margin-left: auto; font-size: 1.25rem; font-weight: 400; line-height: 1; transition: transform var(--duration-normal, 200ms); }
  details[open] > summary::after { transform: rotate(45deg); }
  summary:focus-visible { outline: 2px solid var(--ring, #a1a1aa); outline-offset: 2px; border-radius: calc(var(--radius, 0.625rem) * 0.3); }
  .faq-answer { margin: 0; padding: 0 0.25rem 1.1rem; max-width: 65ch; color: color-mix(in oklab, var(--muted-foreground, #71717a) 70%, var(--foreground, #18181b)); }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; animation-iteration-count: 1 !important; } }
</style>
<faq-list items={[]} heading="" single={false}>
  <h2 zb-if={heading}><zb-slot name="heading">{heading}</zb-slot></h2>
  <div class="faq">
    <zb-each items={items} as="item" key={item.question}>
      <details name={single ? group : null}>
        <summary>{item.question}</summary>
        <p class="faq-answer">{item.answer}</p>
      </details>
    </zb-each>
  </div>
</faq-list>
