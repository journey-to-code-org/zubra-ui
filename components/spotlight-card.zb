<!--
  A card lit by a soft spotlight that follows the pointer across it, for feature grids and pricing.
  The light is the theme's primary colour at `strength` (a percentage); on touch screens and
  without a pointer, it's an ordinary card.
  @slot - The card's content.
-->
<script>
  let card = null
  let lit = false
  function follow(event) {
    const box = card.getBoundingClientRect()
    card.style.setProperty("--spot-x", `${event.clientX - box.left}px`)
    card.style.setProperty("--spot-y", `${event.clientY - box.top}px`)
    lit = event.pointerType !== "touch"
  }
</script>
<style>
  :host { display: block; }
  .spotlight { position: relative; isolation: isolate; height: 100%; box-sizing: border-box; padding: 1.25rem; border: 1px solid var(--border, #e4e4e7); border-radius: var(--radius, 0.625rem); background: var(--card, #fff); color: var(--card-foreground, #18181b); overflow: hidden; }
  .spotlight::before { content: ""; position: absolute; inset: 0; z-index: -1; background: radial-gradient(var(--spot-size, 22rem) circle at var(--spot-x, 50%) var(--spot-y, 0%), color-mix(in oklab, var(--primary, #18181b) var(--spot-strength), transparent), transparent 70%); opacity: 0; transition: opacity var(--duration-slow, 400ms) var(--ease-out, ease-out); pointer-events: none; }
  .spotlight-lit::before { opacity: 1; }
  .spotlight-lit { border-color: color-mix(in oklab, var(--primary, #18181b) 30%, var(--border, #e4e4e7)); }
  .spotlight { transition: border-color var(--duration-slow, 400ms) var(--ease-out, ease-out); }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; animation-iteration-count: 1 !important; } }
</style>
<spotlight-card strength={14}>
  <div class="spotlight" ref={card} class:spotlight-lit={lit} style:--spot-strength={`${Math.min(100, Math.max(0, strength))}%`} onpointermove={follow} onpointerleave={() => (lit = false)}>
    <zb-slot></zb-slot>
  </div>
</spotlight-card>
