<!--
  A list of tags you type: Enter or comma adds one, Backspace in the empty field removes the
  last, × removes any. Suggestions come from `suggestions`. A form control.
  @fires valuechange - The tags changed; `detail` is the new array.
-->
<script>
  import { formValue, id } from '@zubra/runtime'

  const listId = id()
  let draft = ""
  let input = null
  const offered = suggestions.filter((tag) => !value.includes(tag))

  formValue(() => value.join(","))

  function set(next) {
    value = next
  }
  function add(text) {
    const tag = text.trim().toLowerCase().replace(/\s+/g, "-")
    draft = ""
    if (tag && !value.includes(tag) && value.length < max) set([...value, tag])
  }
  // A pasted list ("a, b, c") is several tags.
  function paste(event) {
    const text = event.clipboardData.getData('text')
    if (!/[,\n]/.test(text)) return
    event.preventDefault()
    let next = value
    for (const part of text.split(/[,\n]/)) {
      const tag = part.trim().toLowerCase().replace(/\s+/g, "-")
      if (tag && !next.includes(tag) && next.length < max) next = [...next, tag]
    }
    draft = ""
    set(next)
  }
  function remove(tag) {
    set(value.filter((item) => item !== tag))
    // The × button goes away with its tag: keep focus in the field.
    input?.focus()
  }
  function key(event) {
    if (event.key === 'Enter' || event.key === ',') {
      event.preventDefault()
      add(draft)
    } else if (event.key === 'Backspace' && !draft && value.length) {
      set(value.slice(0, -1))
    }
  }
</script>
<style>
  :host { display: block; }
  .box { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; padding: 0.35rem 0.4rem; border: 1px solid var(--border, #d9dce3); border-radius: 0.6rem; background: var(--card, #ffffff); }
  .box:focus-within { outline: 2px solid var(--primary, #4f5df5); outline-offset: 1px; }
  .tag { display: inline-flex; align-items: center; gap: 0.15rem; padding: 0.1rem 0.2rem 0.1rem 0.5rem; border-radius: 0.4rem; background: var(--chip, var(--secondary, #f4f4f5)); color: var(--chip-ink, var(--secondary-foreground, #18181b)); font-size: 0.8125rem; font-weight: 600; }
  .tag button { display: inline-grid; place-items: center; min-width: 1.5rem; min-height: 1.5rem; border: 0; border-radius: 0.3rem; background: none; color: inherit; padding: 0; cursor: pointer; font: inherit; font-size: 1rem; }
  .tag button:hover { background: color-mix(in oklab, currentColor 12%, transparent); }
  input { flex: 1; min-width: 7rem; border: 0; outline: 0; padding: 0.3rem; font: inherit; background: none; color: inherit; }
  .hint { margin: 0.3rem 0 0; font-size: 0.75rem; color: var(--muted-foreground, #667085); }
</style>
<tag-input form-associated value:model={[]} suggestions={[]} max={6} label="Tags">
  <div class="box">
    <zb-each items={value} as="tag" key={tag}>
      <span class="tag">{tag}<button type="button" aria-label={`Remove ${tag}`} onclick={() => remove(tag)}>×</button></span>
    </zb-each>
    <input aria-label={label} list={listId} placeholder={value.length >= max ? "" : "Add a tag…"} ref={input} readonly={value.length >= max} value={draft} oninput={(event) => (draft = event.target.value)} onkeydown={key} onpaste={paste} onblur={() => draft.trim() && add(draft)} onchange={(event) => offered.includes(event.target.value) && add(event.target.value)}>
    <datalist id={listId}><zb-each items={offered} as="tag" key={tag}><option value={tag}></option></zb-each></datalist>
  </div>
  <p class="hint" aria-live="polite">{value.length >= max ? `That's the most tags (${max}). Remove one to add another.` : `Press Enter after each tag. ${value.length} of ${max}.`}</p>
</tag-input>
