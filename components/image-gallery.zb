<!--
  A photo gallery: a masonry grid in reading order, and a lightbox with the photo at full size,
  its caption, and previous and next (arrow keys too). Photos come from `items`, or from `src`, the
  URL of a gallery.json that `npx zubra-imager <photos>` writes (sizes in AVIF, WebP and JPEG, alt
  text, placeholders). Each photo is `{ src, alt, width, height, srcset?, sources?, caption?,
  placeholder? }`: with `width` and `height`, the grid doesn't jump as photos load. `index` is the
  open photo (-1 when closed) and is two-way.
-->
<script>
  import { effect, onMount } from '@zubra/runtime'

  let grid = null
  let dialog = null
  let loaded = null
  let failed = false
  let pressedBackdrop = false

  const photos = src ? loaded ?? [] : items
  const current = index >= 0 && index < photos.length ? photos[index] : null
  // A manifest's URLs are relative to the manifest.
  const base = src && typeof document !== "undefined" ? new URL(src, document.baseURI) : null
  const url = (path) => (base && path && !/^([a-z][a-z0-9+.-]*:|\/)/i.test(path) ? new URL(path, base).href : path)
  const srcset = (set) => set ? set.split(",").map((entry) => entry.trim().split(/\s+/)).map(([path, size]) => (size ? `${url(path)} ${size}` : url(path))).join(", ") : null

  effect(() => {
    if (!src) return
    failed = false
    fetch(src)
      .then((response) => { if (!response.ok) throw new Error(response.statusText); return response.json() })
      .then((data) => { loaded = Array.isArray(data) ? data : data.items ?? [] })
      .catch(() => { failed = true })
  })

  // The lightbox follows `index`: open on a photo, closed at -1.
  effect(() => {
    if (!dialog) return
    if (current && !dialog.open) dialog.showModal()
    else if (!current && dialog.open) dialog.close()
  })
  function move(by) {
    if (photos.length) index = (index + by + photos.length) % photos.length
  }

  // Masonry in reading order: each item spans as many small grid rows as it is tall, so the grid
  // packs them while the DOM (and Tab) stays left to right, top to bottom.
  onMount(() => {
    const ROW = 8
    const fit = (item) => {
      const gap = parseFloat(getComputedStyle(grid).columnGap) || 0
      item.style.gridRowEnd = `span ${Math.max(1, Math.ceil((item.getBoundingClientRect().height + gap) / ROW))}`
    }
    const sizes = new ResizeObserver((entries) => entries.forEach((entry) => fit(entry.target)))
    const watch = () => [...grid.children].forEach((item) => sizes.observe(item))
    watch()
    const added = new MutationObserver(watch)
    added.observe(grid, { childList: true })
    return () => { sizes.disconnect(); added.disconnect() }
  })
</script>
<style>
  :host { display: block; inline-size: 100%; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--column, 14rem)), 1fr)); grid-auto-rows: 8px; column-gap: var(--gap, 0.75rem); margin: 0; padding: 0; list-style: none; }
  .grid > li { align-self: start; }
  figure { margin: 0; }
  .thumb { display: block; width: 100%; padding: 0; border: 0; border-radius: var(--radius, 0.6rem); overflow: hidden; background: var(--muted, #f4f4f5) center / cover no-repeat; cursor: zoom-in; }
  .thumb img { display: block; width: 100%; height: auto; transition: transform var(--duration-normal, 200ms); }
  .thumb:hover img { transform: scale(1.03); }
  .thumb:focus-visible { outline: 2px solid var(--primary, #18181b); outline-offset: 2px; }
  figcaption { padding: 0.35rem 0.1rem 0; color: var(--muted-foreground, #71717a); font-size: 0.875rem; }
  .status { color: var(--destructive, #d92d20); }
  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #0b0d12f2; color: #f4f4f5; }
  .lightbox::backdrop { background: transparent; }
  .lightbox[open] { display: grid; grid-template: 1fr auto / 3.5rem 1fr 3.5rem; align-items: center; }
  .lightbox figure { grid-area: 1 / 1 / 3 / 4; display: grid; grid-template-rows: 1fr auto; height: 100%; min-height: 0; pointer-events: none; }
  .lightbox picture { display: grid; place-items: center; min-height: 0; padding: 3.5rem 3.5rem 0.5rem; }
  /* Fits the screen, leaving room for the buttons and the caption. */
  .lightbox img { max-width: calc(100vw - 7rem); max-height: calc(100dvh - 8rem); width: auto; height: auto; object-fit: contain; border-radius: calc(var(--radius, 0.625rem) * 0.64); pointer-events: auto; }
  .lightbox figcaption { display: flex; justify-content: space-between; gap: 1rem; padding: 0.75rem 1.25rem 1.25rem; color: #e4e4e7; font-size: 1rem; }
  .count { color: #a1a1aa; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .lightbox button { z-index: 1; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; border-radius: 50%; background: #ffffff1f; color: inherit; font-size: 1.6rem; line-height: 1; cursor: pointer; }
  .lightbox button:hover { background: #ffffff33; }
  .lightbox button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .close { position: absolute; top: 0.75rem; right: 0.75rem; }
  .prev { grid-area: 1 / 1; justify-self: center; }
  .next { grid-area: 1 / 3; justify-self: center; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; animation-iteration-count: 1 !important; } }
</style>
<image-gallery items={[]} src="" index:model={-1} label="Photos">
  <p zb-if={failed} class="status" role="status">Couldn't load the photos from {src}.</p>
  <ul class="grid" ref={grid} aria-label={label}>
    <zb-each items={photos} as="photo" index="i" key={photo.src}>
      <li>
        <figure>
          <button type="button" class="thumb" aria-haspopup="dialog" style:background-image={photo.placeholder ? `url("${photo.placeholder}")` : null} onclick={() => (index = i)}>
            <img src={url(photo.src)} srcset={srcset(photo.srcset)} sizes="(max-width: 40rem) 100vw, 30rem" width={photo.width} height={photo.height} alt={photo.alt ?? ""} loading="lazy" decoding="async">
          </button>
          <figcaption zb-if={photo.caption}>{photo.caption}</figcaption>
        </figure>
      </li>
    </zb-each>
  </ul>
  <dialog ref={dialog} class="lightbox" aria-label={current?.alt ?? label} onclose={() => (index = -1)} onpointerdown={(event) => (pressedBackdrop = event.target === dialog)} onclick.self={() => pressedBackdrop && (index = -1)} onkeydown.left.prevent={() => move(-1)} onkeydown.right.prevent={() => move(1)}>
    <figure zb-if={current}>
      <picture>
        <zb-each items={current?.sources ?? []} as="source" key={source.type}>
          <source type={source.type} srcset={srcset(source.srcset)} sizes="100vw">
        </zb-each>
        <img src={url(current?.src)} srcset={srcset(current?.srcset)} sizes="100vw" width={current?.width} height={current?.height} alt={current?.alt ?? ""}>
      </picture>
      <figcaption><span>{current?.caption ?? current?.alt}</span><span class="count">{index + 1} of {photos.length}</span></figcaption>
    </figure>
    <button type="button" class="close" aria-label="Close" onclick={() => (index = -1)}>×</button>
    <button type="button" class="prev" aria-label="Previous photo" zb-if={photos.length > 1} onclick={() => move(-1)}>‹</button>
    <button type="button" class="next" aria-label="Next photo" zb-if={photos.length > 1} onclick={() => move(1)}>›</button>
  </dialog>
</image-gallery>
