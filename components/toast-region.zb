<!--
  Short notifications that appear in a corner and go away by themselves. Put one region on the
  page; anything (a framework, a plain script) shows a toast by dispatching an event, so nothing
  needs a reference to it:
  `document.dispatchEvent(new CustomEvent('toast', { detail: { message: 'Saved', variant: 'success' } }))`.
  `detail` takes `message`, `heading`, `variant` (info, success, warning, danger), `duration` in
  ms (0 keeps it until closed) and `action: { label, href }`. Toasts are announced politely (an
  error assertively), wait while hovered or focused, close with Escape (the newest first), and show above dialogs (the top layer;
  while a modal dialog is open the rest of the page is inert, so a toast's buttons work once it closes).
  @fires toastclose - A toast closed; `detail` is its message.
-->
<script>
  import { emit, onMount, onUnmount } from '@zubra/runtime'

  let toasts = []
  let region = null
  let paused = false
  let next = 1
  const timers = new Map()

  function remove(toast) {
    clearTimeout(timers.get(toast.id))
    timers.delete(toast.id)
    toasts = toasts.filter((item) => item.id !== toast.id)
    emit('toastclose', toast.message)
  }
  function schedule(toast) {
    if (!toast.duration || paused) return
    clearTimeout(timers.get(toast.id))
    timers.set(toast.id, setTimeout(() => remove(toast), toast.duration))
  }
  function show(event) {
    const detail = typeof event.detail === "string" ? { message: event.detail } : event.detail ?? {}
    const toast = { id: next++, message: String(detail.message ?? ""), heading: detail.heading ?? "", variant: detail.variant ?? "info", duration: detail.duration ?? duration, action: detail.action ?? null }
    // The same message again replaces the one showing, rather than stacking a copy.
    toasts = [...toasts.filter((item) => item.message !== toast.message || item.heading !== toast.heading).slice(-(max - 1)), toast]
    // In the top layer, so a toast shows above an open modal dialog.
    if (region && !region.matches(":popover-open")) region.showPopover?.()
    schedule(toast)
  }
  function pause(on) {
    paused = on
    if (on) { timers.forEach((timer) => clearTimeout(timer)); timers.clear() }
    else toasts.forEach(schedule)
  }
  // Escape closes the newest toast, unless a dialog or menu is using it.
  function escape(event) {
    if (!toasts.length || event.defaultPrevented || document.querySelector("dialog:modal, :popover-open:not(section)")) return
    remove(toasts[toasts.length - 1])
  }
  onUnmount(() => timers.forEach((timer) => clearTimeout(timer)))
  // A dismissed toast slides out, and the rest close the gap.
  onMount(() => presence(region, true))

  // ---- motion polyfill: what `animate` does in @zubra/compiler from journey-to-code-org/zubra#116,
  // done from outside until that release is on npm (polyfill/README.md says how to remove it).
  // Elements removed from `container` come back with data-leaving and inert, and go once the
  // transitions and animations that starts have ended (infinite ones aren't waited for). With
  // `glides`, removed elements leave held in place out of the flow, and the rest glide to their new
  // places (--zb-move-duration, --zb-move-easing). Under reduced motion, none of it. `container`
  // must be positioned when it glides. Returns a cleanup, for onMount.
  function presence(container, glides = false) {
    const reduced = () => !!globalThis.matchMedia?.("(prefers-reduced-motion: reduce)").matches
    const leaving = new WeakSet()
    let places = new Map()
    // Where an element is laid out in the (positioned) container: offsets, which a glide's transform
    // doesn't change, so one change can interrupt another.
    const where = (node) => ({ x: node.offsetLeft, y: node.offsetTop, width: node.offsetWidth, height: node.offsetHeight })
    // What each element looks like now (what its transitions animate, and its animation), so one
    // that's put back after being removed starts leaving from there rather than as if new.
    const looks = (node) => {
      const style = getComputedStyle(node)
      const names = style.transitionProperty.split(",").map((name) => name.trim())
      const animated = names.includes("all") ? ["opacity", "transform", "translate", "scale", "rotate", "filter", "clip-path"] : names.filter((name) => name !== "none")
      return { values: animated.map((name) => [name, style.getPropertyValue(name)]), animation: style.animationName }
    }
    const sizes = new ResizeObserver(() => snapshot())
    const snapshot = () => {
      places = new Map()
      for (const child of container.children) {
        if (leaving.has(child)) continue
        places.set(child, { ...where(child), ...looks(child) })
        sizes.observe(child)
      }
    }
    const leave = (node, place) => {
      leaving.add(node)
      node.inert = true
      if (glides && place) Object.assign(node.style, { position: "absolute", top: `${place.y}px`, left: `${place.x}px`, width: `${place.width}px`, height: `${place.height}px`, margin: "0" })
      if (!place) node.setAttribute("data-leaving", "")
      else {
        // Back as it was (held there, above any animation), then let go into data-leaving. Its own
        // animation doesn't play again; one that data-leaving starts does.
        node.style.setProperty("transition", "none")
        node.style.setProperty("animation", "none")
        for (const [name, value] of place.values) node.style.setProperty(name, value, "important")
        node.setAttribute("data-leaving", "")
        getComputedStyle(node).opacity
        for (const [name] of place.values) node.style.removeProperty(name)
        node.style.removeProperty("transition")
        getComputedStyle(node).opacity // the transitions start here, before any animation can stop them
        node.style.removeProperty("animation")
        if (getComputedStyle(node).animationName === place.animation) node.style.setProperty("animation", "none")
      }
      // getAnimations() brings styles up to date, so it sees what data-leaving started.
      const running = node.getAnimations({ subtree: true }).filter((animation) => animation.effect?.getComputedTiming().endTime !== Infinity && animation.playState !== "finished")
      if (!running.length) node.remove()
      else Promise.allSettled(running.map((animation) => animation.finished)).then(() => node.remove())
    }
    const changes = new MutationObserver((records) => {
      if (reduced()) return snapshot()
      // Each removed element goes back where it was: after what was before it (or what went back
      // there already), so several in a row keep their order.
      const after = new Map()
      for (const record of records) {
        for (const node of record.removedNodes) {
          if (node.nodeType !== 1 || leaving.has(node) || node.isConnected) continue
          const before = after.get(record.previousSibling) ?? record.previousSibling
          if (before?.parentNode === container) before.after(node)
          else if (record.nextSibling?.parentNode === container) record.nextSibling.before(node)
          else container.prepend(node)
          after.set(record.previousSibling, node)
          leave(node, places.get(node))
        }
      }
      if (glides) {
        for (const [node, was] of places) {
          if (leaving.has(node) || node.parentNode !== container) continue
          const now = where(node)
          const x = was.x - now.x
          const y = was.y - now.y
          if (!x && !y) continue
          const style = getComputedStyle(node)
          const time = /^\s*([\d.]+)(ms|s)\s*$/.exec(style.getPropertyValue("--zb-move-duration"))
          const ms = time ? Number(time[1]) * (time[2] === "s" ? 1000 : 1) : 250
          if (ms) node.animate([{ transform: `translate(${x}px, ${y}px)` }, { transform: "none" }], { duration: ms, easing: style.getPropertyValue("--zb-move-easing").trim() || "cubic-bezier(0.2, 0, 0, 1)", composite: "add" })
        }
      }
      snapshot()
    })
    changes.observe(container, { childList: true })
    sizes.observe(container)
    // Seen again once an entrance (or any animation) settles, so the look kept isn't halfway through it.
    container.addEventListener("animationend", snapshot)
    container.addEventListener("transitionend", snapshot)
    snapshot()
    return () => {
      changes.disconnect()
      sizes.disconnect()
      container.removeEventListener("animationend", snapshot)
      container.removeEventListener("transitionend", snapshot)
    }
  }
  // ---- end of the motion polyfill
</script>
<style>
  :host { display: contents; }
  .toast-region { position: fixed; inset: auto; margin: 0; padding: 1rem; border: 0; background: none; overflow: visible; display: grid; gap: 0.6rem; width: min(24rem, 100vw); box-sizing: border-box; pointer-events: none; }
  .toast-region:not(:popover-open) { display: none; }
  .toast-bottom-end { right: 0; bottom: 0; } .toast-bottom-start { left: 0; bottom: 0; } .toast-top-end { right: 0; top: 0; } .toast-top-start { left: 0; top: 0; }
  .toast-bottom-center { left: 50%; bottom: 0; translate: -50% 0; } .toast-top-center { left: 50%; top: 0; translate: -50% 0; }
  .toast-item { pointer-events: auto; display: grid; grid-template-columns: auto 1fr auto; gap: 0.15rem 0.7rem; align-items: start; padding: 0.85rem 0.9rem; border: 1px solid var(--border, #e4e4e7); border-radius: var(--radius, 0.625rem); background: var(--popover, #fff); color: var(--popover-foreground, #18181b); box-shadow: 0 10px 30px #0000001f; animation: enter var(--duration-normal, 200ms) var(--ease-out, ease-out); transition: opacity var(--duration-normal, 200ms) var(--ease-out, ease-out), translate var(--duration-normal, 200ms) var(--ease-out, ease-out); }
  .toast-item[data-leaving] { opacity: 0; translate: 0.75rem 0; }
  .toast-mark { width: 0.6rem; height: 0.6rem; margin-top: 0.4rem; border-radius: 50%; background: oklch(0.55 0.15 255); }
  .toast-success .toast-mark { background: oklch(0.6 0.15 150); } .toast-warning .toast-mark { background: oklch(0.75 0.15 75); } .toast-danger .toast-mark { background: var(--destructive, #dc2626); }
  .toast-content { display: grid; gap: 0.15rem; min-width: 0; }
  strong:empty { display: none; }
  .toast-message { color: color-mix(in oklab, var(--foreground, #18181b) 85%, var(--muted-foreground, #71717a)); }
  .toast-action { justify-self: start; margin-top: 0.3rem; color: var(--primary, #18181b); font-weight: 600; }
  .toast-close { width: 1.6rem; height: 1.6rem; margin: -0.2rem -0.3rem 0 0; border: 0; border-radius: 50%; background: none; color: inherit; font-size: 1.15rem; line-height: 1; cursor: pointer; }
  .toast-close:hover { background: var(--accent, #f4f4f5); }
  .toast-close:focus-visible, .toast-action:focus-visible { outline: 2px solid var(--ring, #a1a1aa); outline-offset: 1px; }
  @keyframes enter { from { opacity: 0; transform: translateY(0.5rem) scale(0.98); } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; animation-iteration-count: 1 !important; } }
</style>
<toast-region position="bottom-end" duration={5000} max={3} label="Notifications">
  <zb-document ontoast={show} onkeydown.escape={escape}></zb-document>
  <section ref={region} popover="manual" class="toast-region toast-{position}" aria-label={label} onmouseenter={() => pause(true)} onmouseleave={() => pause(false)} onfocusin={() => pause(true)} onfocusout={() => pause(false)}>
    <zb-each items={toasts} as="toast" key={toast.id}>
      <div class="toast-item toast-{toast.variant}" role={toast.variant === "danger" ? "alert" : "status"}>
        <span class="toast-mark" aria-hidden="true"></span>
        <div class="toast-content">
          <strong>{toast.heading}</strong>
          <span class="toast-message">{toast.message}</span>
          <a zb-if={toast.action} class="toast-action" href={toast.action?.href}>{toast.action?.label}</a>
        </div>
        <button type="button" class="toast-close" aria-label="Dismiss notification" onclick={() => remove(toast)}>×</button>
      </div>
    </zb-each>
  </section>
</toast-region>
