<!--
  A card that tilts toward the pointer in 3D, up to `max` degrees, and springs back flat when the
  pointer leaves. `glare` adds a sheen where the light would catch it. It stays flat on touch
  screens and for visitors who asked for less motion.
  @slot - The card's content.
-->
<script>
  let card = null
  let tilting = false
  function tilt(event) {
    if (event.pointerType === "touch" || globalThis.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return
    const box = card.getBoundingClientRect()
    const x = (event.clientX - box.left) / box.width - 0.5
    const y = (event.clientY - box.top) / box.height - 0.5
    card.style.setProperty("--tilt-x", `${(-y * 2 * max).toFixed(2)}deg`)
    card.style.setProperty("--tilt-y", `${(x * 2 * max).toFixed(2)}deg`)
    card.style.setProperty("--glare-x", `${((x + 0.5) * 100).toFixed(1)}%`)
    card.style.setProperty("--glare-y", `${((y + 0.5) * 100).toFixed(1)}%`)
    tilting = true
  }
  function rest() {
    tilting = false
    card.style.setProperty("--tilt-x", "0deg")
    card.style.setProperty("--tilt-y", "0deg")
  }
</script>
<style>
  :host { display: block; perspective: 60rem; }
  .tilt { position: relative; height: 100%; box-sizing: border-box; padding: 1.25rem; border: 1px solid var(--border, #e4e4e7); border-radius: var(--radius, 0.625rem); background: var(--card, #fff); color: var(--card-foreground, #18181b); transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)); transform-style: preserve-3d; transition: transform var(--duration-slower, 700ms) var(--ease-spring, ease-out), box-shadow var(--duration-slow, 400ms) var(--ease-out, ease-out); overflow: hidden; }
  .tilt-active { transition: transform var(--duration-fast, 150ms) var(--ease-out, ease-out), box-shadow var(--duration-slow, 400ms) var(--ease-out, ease-out); box-shadow: 0 18px 40px #0000001f; }
  .tilt-glare { position: absolute; inset: 0; background: radial-gradient(circle at var(--glare-x, 50%) var(--glare-y, 50%), #ffffff40, transparent 55%); opacity: 0; transition: opacity var(--duration-slow, 400ms) var(--ease-out, ease-out); pointer-events: none; mix-blend-mode: soft-light; }
  .tilt-active .tilt-glare { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; animation-iteration-count: 1 !important; } }
</style>
<tilt-card max={8} glare={true}>
  <div class="tilt" ref={card} class:tilt-active={tilting} onpointermove={tilt} onpointerleave={rest}>
    <zb-slot></zb-slot>
    <div zb-if={glare} class="tilt-glare" aria-hidden="true"></div>
  </div>
</tilt-card>
