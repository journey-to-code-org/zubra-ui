<!--
  A row that scrolls sideways: cards, photos, episodes. Each child is `item` wide and snaps into
  place. The row is a labelled region that takes focus, so arrow keys scroll it; `controls` adds
  previous and next buttons that move one item at a time, and are disabled at either end.
  @slot - The children.
-->
<script>
  import { onMount } from '@zubra/runtime'

  let reel = null
  let atStart = true
  let atEnd = false

  onMount(() => {
    const update = () => {
      atStart = reel.scrollLeft <= 1
      atEnd = reel.scrollLeft + reel.clientWidth >= reel.scrollWidth - 1
    }
    // The children are the page's, which this component's styles don't reach: each snaps from here.
    const snap = () => { [...reel.children].forEach((item) => { item.style.scrollSnapAlign = 'start' }); update() }
    snap()
    const children = new MutationObserver(snap)
    children.observe(reel, { childList: true })
    const sizes = new ResizeObserver(update)
    sizes.observe(reel)
    reel.addEventListener('scroll', update, { passive: true })
    return () => { children.disconnect(); sizes.disconnect(); reel.removeEventListener('scroll', update) }
  })

  function step(direction) {
    const first = reel.children[0]
    const distance = first ? first.getBoundingClientRect().width + parseFloat(getComputedStyle(reel).columnGap || "0") : reel.clientWidth
    reel.scrollBy({ left: direction * distance, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" })
  }
</script>
<style>
  :host { display: block; }
  .reel-wrap { display: grid; gap: 0.5rem; }
  .reel { display: grid; grid-auto-flow: column; grid-auto-columns: var(--item); gap: var(--gap); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: 0; padding-bottom: 0.5rem; scrollbar-width: thin; scrollbar-color: var(--border, #d4d4d8) transparent; }
  .reel:focus-visible { outline: 2px solid var(--ring, #a1a1aa); outline-offset: 2px; border-radius: 0.25rem; }
  .reel-controls { display: flex; justify-content: flex-end; gap: 0.4rem; }
  .reel-controls button { width: 2.25rem; height: 2.25rem; border: 1px solid var(--border, #e4e4e7); border-radius: 50%; background: var(--background, #fff); color: var(--foreground, #18181b); font: inherit; font-size: 1.1rem; line-height: 1; cursor: pointer; }
  .reel-controls button:hover:not(:disabled) { background: var(--accent, #f4f4f5); }
  .reel-controls button:disabled { opacity: 0.4; cursor: default; }
  .reel-controls button:focus-visible { outline: 2px solid var(--ring, #a1a1aa); outline-offset: 2px; }
</style>
<reel-layout item="16rem" gap="1rem" label="Items" controls={false}>
  <div class="reel-wrap">
    <div zb-if={controls} class="reel-controls">
      <button type="button" aria-label="Previous" disabled={atStart} onclick={() => step(-1)}>‹</button>
      <button type="button" aria-label="Next" disabled={atEnd} onclick={() => step(1)}>›</button>
    </div>
    <div class="reel" ref={reel} role="region" aria-label={label} tabindex="0" style:--item={item} style:--gap={gap}><zb-slot></zb-slot></div>
  </div>
</reel-layout>
