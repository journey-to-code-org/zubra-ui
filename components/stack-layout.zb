<!--
  Children one above the other with the same space between them: the vertical rhythm of a page,
  a form or a card. `gap` is any CSS length.
  @slot - The children.
-->
<style>
  :host { display: block; }
  .stack { display: flex; flex-direction: column; gap: var(--gap); }
</style>
<stack-layout gap="1rem">
  <div class="stack" style:--gap={gap}><zb-slot></zb-slot></div>
</stack-layout>
