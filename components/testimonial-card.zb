<!--
  A quote from a customer, with who said it: their name, their role or company (`byline`), and their
  picture (or initials). Marked up as a <figure> with a <blockquote> and a <figcaption>.
  @slot - The quote.
-->
<script>
  let failed = false
  // Plain string methods, so the server renders them too (a pattern is the browser's alone): a
  // tab or line break between the names counts as a space.
  const initials = name.replaceAll("\t", " ").replaceAll("\n", " ").replaceAll("\r", " ").trim().split(" ").filter((part) => part !== "").map((part) => part[0]).slice(0, 2).join("").toUpperCase()
</script>
<style>
  :host { display: block; }
  figure { display: grid; gap: 1rem; height: 100%; margin: 0; padding: 1.4rem; border: 1px solid var(--border, #e4e4e7); border-radius: var(--radius, 0.625rem); background: var(--card, #fff); box-sizing: border-box; }
  blockquote { margin: 0; font-size: 1.05rem; line-height: 1.55; text-wrap: pretty; }
  blockquote::before { content: "“"; display: block; height: 1.5rem; font-size: 3rem; line-height: 1; color: var(--primary, #18181b); opacity: 0.5; }
  figcaption { display: flex; align-items: center; gap: 0.75rem; margin-top: auto; }
  .quote-photo { display: grid; place-items: center; flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--muted, #f4f4f5); font-weight: 700; font-size: 0.9rem; overflow: hidden; }
  .quote-photo img { width: 100%; height: 100%; object-fit: cover; }
  .quote-who { display: grid; }
  .quote-name { font-weight: 700; }
  .quote-role { font-size: 0.85rem; color: color-mix(in oklab, var(--muted-foreground, #71717a) 75%, var(--foreground, #18181b)); }
</style>
<testimonial-card name="" byline="" src="">
  <figure>
    <blockquote><zb-slot></zb-slot></blockquote>
    <figcaption>
      <span class="quote-photo" aria-hidden="true"><img zb-if={src && !failed} src={src} alt="" onerror={() => (failed = true)}><span zb-else>{initials}</span></span>
      <span class="quote-who"><span class="quote-name">{name}</span><span class="quote-role">{byline}</span></span>
    </figcaption>
  </figure>
</testimonial-card>
