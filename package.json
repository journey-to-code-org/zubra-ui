{
  "name": "zubra-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Zubra UI: accessible web components you copy into any project, written in Zubra and themed with shadcn/ui's variables.",
  "type": "module",
  "license": "ISC",
  "author": "Mikey Nichols",
  "repository": {
    "type": "git",
    "url": "https://github.com/journey-to-code-org/zubra-ui"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/site.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "npm run build && node --test \"test/*.test.js\" \"imager/test/*.test.js\"",
    "test:element": "npm run build && node scripts/test-element.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@zag-js/combobox": "1.47.0",
    "@zag-js/vanilla": "1.47.0",
    "@zubra/compiler": "^5.5.0",
    "@zubra/runtime": "^5.5.0",
    "axe-core": "4.14.0",
    "esbuild": "0.27.3",
    "playwright": "1.63.0"
  },
  "workspaces": [
    "imager"
  ]
}
